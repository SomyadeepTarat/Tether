# Backend loads backend/.env then root .env; explicit process settings take precedence.
# Engine CLI loads root .env. Keep credentials local and restart the backend after edits.
TETHER_DB=backend/data/tether.sqlite3
TETHER_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=15
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# groq: hosted primary with local backup; groq-only: hosted without fallback.
# ollama: explicit offline inference. Never use NEXT_PUBLIC_ for credentials.
