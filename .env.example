# Set in the BACKEND environment only. Never use NEXT_PUBLIC_ for this key.
# This file is a template; scripts do not load it automatically.
TETHER_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=15
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
TETHER_DB=runtime/tether.sqlite3
# TETHER_PROVIDER=groq uses Groq first, then local Ollama on eligible failures.
# TETHER_PROVIDER=groq-only disables backup for honest provider benchmarking.
# TETHER_PROVIDER=ollama forces offline/local inference.
